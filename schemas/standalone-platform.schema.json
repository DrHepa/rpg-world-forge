{
  "$defs": {
    "file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "maximum": 33554432,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^(?!(?:aux|con|nul|prn|com[1-9]|lpt[1-9])$)[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?![./])(?!.*/(?:\\.{1,2})(?:/|$))(?!(?:.*[/])?(?:aux|con|nul|prn|com[1-9]|lpt[1-9])(?:[./]|$))[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*(?:/[a-zA-Z0-9_.@ -]+)*$",
      "type": "string"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/standalone-platform.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/id"
        },
        "adapter_version": {
          "$ref": "#/$defs/semver"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "content_hash"
      ],
      "type": "object"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "dependency": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "const": "raylib"
        },
        "import_module": {
          "const": "pyray"
        },
        "native_api": {
          "const": "raylib-5.5"
        },
        "pin": {
          "const": "raylib==6.0.1.0"
        },
        "version": {
          "const": "6.0.1.0"
        }
      },
      "required": [
        "distribution",
        "version",
        "pin",
        "import_module",
        "native_api"
      ],
      "type": "object"
    },
    "format": {
      "const": "world-forge.standalone_platform"
    },
    "format_version": {
      "const": 1
    },
    "platform_locks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "abi": {
            "enum": [
              "cp311",
              "cp312"
            ]
          },
          "content_hash": {
            "$ref": "#/$defs/sha256"
          },
          "lock_id": {
            "$ref": "#/$defs/id"
          },
          "os": {
            "enum": [
              "linux",
              "windows"
            ]
          },
          "python_minor": {
            "enum": [
              "3.11",
              "3.12"
            ]
          }
        },
        "required": [
          "lock_id",
          "content_hash",
          "os",
          "python_minor",
          "abi"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array",
      "uniqueItems": true,
      "x-world-forge-canonical-object-array": {
        "orderBy": [
          "lock_id"
        ],
        "uniqueBy": [
          [
            "lock_id"
          ]
        ]
      }
    },
    "platform_set_id": {
      "pattern": "^standalone_platform_[0-9a-f]{40}$",
      "type": "string"
    },
    "requires_python": {
      "const": ">=3.11,<3.13"
    },
    "runtime_implementation": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "implementation_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "implementation_id",
        "content_hash"
      ],
      "type": "object"
    },
    "runtime_snapshot": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "tree_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "snapshot_id",
        "content_hash",
        "tree_hash"
      ],
      "type": "object"
    }
  },
  "required": [
    "format",
    "format_version",
    "platform_set_id",
    "requires_python",
    "dependency",
    "adapter",
    "runtime_implementation",
    "runtime_snapshot",
    "platform_locks",
    "content_hash"
  ],
  "title": "World Forge standalone runtime platform set v1",
  "type": "object",
  "x-world-forge-canonical-content-hash": true,
  "x-world-forge-standalone-platform-coherent": true
}
