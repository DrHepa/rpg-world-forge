{
  "$defs": {
    "adapterIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_adapter"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "assetpackIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.assetpack"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "inventory_hash": {
          "$ref": "#/$defs/sha256"
        },
        "root_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash",
        "root_hash",
        "inventory_hash"
      ],
      "type": "object"
    },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "binding_id": {
          "$ref": "#/$defs/id"
        },
        "media_type": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "runtime_path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "binding_id",
        "asset_id",
        "role",
        "media_type",
        "runtime_path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "gamepackIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.gamepack"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^(?!(?:aux|con|nul|prn|com[1-9]|lpt[1-9])$)[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "inventoryIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.asset_inventory"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?![./])(?!.*/(?:\\.{1,2})(?:/|$))(?!(?:.*[/])?(?:aux|con|nul|prn|com[1-9]|lpt[1-9])(?:[./]|$))[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*(?:/[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*)*$",
      "type": "string"
    },
    "platform": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:linux"
            },
            "platform_id": {
              "const": "platform:linux_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:windows"
            },
            "platform_id": {
              "const": "platform:windows_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        }
      ]
    },
    "registryIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_adapter_registry"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "runtimeApi": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshotIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_runtime_snapshot"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "token": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/game-runtime-composition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "$ref": "#/$defs/adapterIdentity"
    },
    "asset_inventory": {
      "$ref": "#/$defs/inventoryIdentity"
    },
    "assetpack": {
      "$ref": "#/$defs/assetpackIdentity"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "composition_id": {
      "$ref": "#/$defs/id"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "format": {
      "const": "world-forge.game_runtime_composition"
    },
    "format_version": {
      "const": 1
    },
    "gamepack": {
      "$ref": "#/$defs/gamepackIdentity"
    },
    "platforms": {
      "items": {
        "$ref": "#/$defs/platform"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "registry": {
      "$ref": "#/$defs/registryIdentity"
    },
    "runtime_snapshot": {
      "$ref": "#/$defs/snapshotIdentity"
    }
  },
  "required": [
    "format",
    "format_version",
    "composition_id",
    "gamepack",
    "asset_inventory",
    "assetpack",
    "adapter",
    "registry",
    "runtime_snapshot",
    "platforms",
    "bindings",
    "content_hash"
  ],
  "title": "World Forge exact game-runtime composition v1",
  "type": "object",
  "x-world-forge-canonical-content-hash": true,
  "x-world-forge-generic-runtime-coherent": "game-runtime-composition"
}
