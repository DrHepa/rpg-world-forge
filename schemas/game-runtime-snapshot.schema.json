{
  "$defs": {
    "adapterIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_adapter"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "maximum": 4194304,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^(?!(?:aux|con|nul|prn|com[1-9]|lpt[1-9])$)[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?![./])(?!.*/(?:\\.{1,2})(?:/|$))(?!(?:.*[/])?(?:aux|con|nul|prn|com[1-9]|lpt[1-9])(?:[./]|$))[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*(?:/[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*)*$",
      "type": "string"
    },
    "platform": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:linux"
            },
            "platform_id": {
              "const": "platform:linux_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:windows"
            },
            "platform_id": {
              "const": "platform:windows_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        }
      ]
    },
    "runtimeApi": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "token": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/game-runtime-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_descriptors": {
      "items": {
        "$ref": "#/$defs/adapterIdentity"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/file"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "format": {
      "const": "world-forge.game_runtime_snapshot"
    },
    "format_version": {
      "const": 1
    },
    "runtime_api": {
      "$ref": "#/$defs/runtimeApi"
    },
    "snapshot_id": {
      "$ref": "#/$defs/id"
    },
    "tree_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "format",
    "format_version",
    "snapshot_id",
    "runtime_api",
    "adapter_descriptors",
    "files",
    "tree_hash",
    "content_hash"
  ],
  "title": "World Forge deterministic game-runtime snapshot v1",
  "type": "object",
  "x-world-forge-canonical-content-hash": true,
  "x-world-forge-generic-runtime-coherent": "game-runtime-snapshot"
}
