{
  "$defs": {
    "file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "maximum": 33554432,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^(?!(?:aux|con|nul|prn|com[1-9]|lpt[1-9])$)[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?![./])(?!.*/(?:\\.{1,2})(?:/|$))(?!(?:.*[/])?(?:aux|con|nul|prn|com[1-9]|lpt[1-9])(?:[./]|$))[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*(?:/[a-zA-Z0-9_.@ -]+)*$",
      "type": "string"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/runtime-platform-lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "dependency": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "additionalProperties": false,
          "properties": {
            "filename": {
              "pattern": "^raylib-6\\.0\\.1\\.0-cp31[12]-cp31[12]-.*\\.whl$",
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size_bytes": {
              "maximum": 16777216,
              "minimum": 1,
              "type": "integer"
            },
            "url": {
              "const": "https://pypi.org/project/raylib/6.0.1.0/#files"
            }
          },
          "required": [
            "filename",
            "size_bytes",
            "url",
            "sha256"
          ],
          "type": "object"
        },
        "distribution": {
          "const": "raylib"
        },
        "import_module": {
          "const": "pyray"
        },
        "native_api": {
          "const": "raylib-5.5"
        },
        "pin": {
          "const": "raylib==6.0.1.0"
        },
        "version": {
          "const": "6.0.1.0"
        }
      },
      "required": [
        "distribution",
        "version",
        "pin",
        "import_module",
        "native_api",
        "artifact"
      ],
      "type": "object"
    },
    "format": {
      "const": "world-forge.runtime_platform_lock"
    },
    "format_version": {
      "const": 1
    },
    "lock_id": {
      "pattern": "^runtime_platform_lock_[0-9a-f]{40}$",
      "type": "string"
    },
    "platform": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "x86_64"
        },
        "backend": {
          "const": "backend:raylib"
        },
        "os": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "renderer": {
          "const": "raylib"
        }
      },
      "required": [
        "os",
        "architecture",
        "backend",
        "renderer"
      ],
      "type": "object"
    },
    "python": {
      "additionalProperties": false,
      "properties": {
        "abi": {
          "enum": [
            "cp311",
            "cp312"
          ]
        },
        "implementation": {
          "const": "cpython"
        },
        "minor": {
          "enum": [
            "3.11",
            "3.12"
          ]
        },
        "requires_python": {
          "const": ">=3.11,<3.13"
        }
      },
      "required": [
        "implementation",
        "minor",
        "abi",
        "requires_python"
      ],
      "type": "object"
    }
  },
  "required": [
    "format",
    "format_version",
    "lock_id",
    "platform",
    "python",
    "dependency",
    "content_hash"
  ],
  "title": "World Forge audited runtime platform lock v1",
  "type": "object",
  "x-world-forge-canonical-content-hash": true,
  "x-world-forge-runtime-platform-lock-audited": true
}
