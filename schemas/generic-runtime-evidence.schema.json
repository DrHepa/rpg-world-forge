{
  "$defs": {
    "adapterIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_adapter"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "check": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "enum": [
            "check:headless_determinism",
            "check:native_raylib",
            "check:package_verification",
            "check:save_replay"
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "headless",
            "native",
            "packaging",
            "save_replay"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        }
      },
      "required": [
        "check_id",
        "kind",
        "status",
        "evidence_id",
        "content_hash"
      ],
      "type": "object"
    },
    "compositionIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_runtime_composition"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^(?!(?:aux|con|nul|prn|com[1-9]|lpt[1-9])$)[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?![./])(?!.*/(?:\\.{1,2})(?:/|$))(?!(?:.*[/])?(?:aux|con|nul|prn|com[1-9]|lpt[1-9])(?:[./]|$))[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*(?:/[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*)*$",
      "type": "string"
    },
    "platform": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:linux"
            },
            "platform_id": {
              "const": "platform:linux_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:windows"
            },
            "platform_id": {
              "const": "platform:windows_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        }
      ]
    },
    "runtimeApi": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "token": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/generic-runtime-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "$ref": "#/$defs/adapterIdentity"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/check"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "composition": {
      "$ref": "#/$defs/compositionIdentity"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_id": {
      "$ref": "#/$defs/id"
    },
    "execution_status": {
      "enum": [
        "headless_verified",
        "native_verified",
        "failed"
      ]
    },
    "format": {
      "const": "world-forge.runtime_evidence"
    },
    "format_version": {
      "const": 1
    },
    "packaging_status": {
      "enum": [
        "unverified",
        "verified",
        "failed"
      ]
    },
    "platform": {
      "$ref": "#/$defs/platform"
    }
  },
  "required": [
    "format",
    "format_version",
    "evidence_id",
    "composition",
    "adapter",
    "platform",
    "execution_status",
    "packaging_status",
    "checks",
    "content_hash"
  ],
  "title": "World Forge external runtime evidence claim v1",
  "type": "object",
  "x-world-forge-canonical-content-hash": true,
  "x-world-forge-generic-runtime-coherent": "generic-runtime-evidence"
}
