{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-forge.local/schemas/legacy-identity-allowlist.schema.json",
  "title": "World Forge legacy identity allowlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "entries"],
  "properties": {
    "format": {"const": "world-forge.legacy_identity_allowlist"},
    "format_version": {"const": 1},
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "file_sha256",
          "justification",
          "offsets",
          "path",
          "pattern"
        ],
        "properties": {
          "category": {
            "enum": [
              "compatibility_reader",
              "historical_provenance",
              "legacy_contract",
              "license_third_party_notice",
              "migration",
              "regression_fixture"
            ]
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "justification": {"type": "string", "minLength": 1},
          "offsets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._/-]+$"
          },
          "pattern": {"enum": ["RPG World Forge", "rpg-world-forge"]}
        }
      }
    }
  }
}
