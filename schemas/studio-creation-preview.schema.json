{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-forge.local/schemas/studio-creation-preview.schema.json",
  "title": "World Forge Studio creation preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "handle",
    "workspace_id",
    "assetpack_artifact_id",
    "output_grant_id",
    "output_grant_generation",
    "asset_id",
    "media_type",
    "byte_length",
    "sha256",
    "chunk_bytes",
    "metadata"
  ],
  "properties": {
    "format": {
      "const": "world-forge.studio_creation_preview"
    },
    "format_version": {
      "const": 1
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "assetpack_artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "output_grant_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "output_grant_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "media_type": {
      "enum": [
        "audio/wav",
        "image/png"
      ]
    },
    "byte_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chunk_bytes": {
      "const": 65536
    },
    "metadata": {
      "oneOf": [
        {
          "$ref": "#/$defs/pngMetadata"
        },
        {
          "$ref": "#/$defs/wavMetadata"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "media_type": {
          "const": "image/png"
        },
        "metadata": {
          "$ref": "#/$defs/pngMetadata"
        }
      },
      "required": [
        "media_type",
        "metadata"
      ]
    },
    {
      "properties": {
        "media_type": {
          "const": "audio/wav"
        },
        "metadata": {
          "$ref": "#/$defs/wavMetadata"
        }
      },
      "required": [
        "media_type",
        "metadata"
      ]
    }
  ],
  "$defs": {
    "pngMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "width",
        "height",
        "mode"
      ],
      "properties": {
        "kind": {
          "const": "png"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "mode": {
          "enum": [
            "grayscale8",
            "rgb8",
            "rgba8"
          ]
        }
      }
    },
    "wavMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "channels",
        "sample_rate",
        "frames",
        "sample_width"
      ],
      "properties": {
        "kind": {
          "const": "wav_pcm16"
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 192000000
        },
        "sample_width": {
          "const": 2
        }
      }
    }
  }
}
