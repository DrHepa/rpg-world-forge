{
  "$defs": {
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "evidence_id",
        "claim",
        "subject"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "if": {
            "properties": {
              "format": {
                "const": "world-forge.game_runtime_bundle"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^game_runtime_bundle_[0-9a-f]{48}$",
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "manifestIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.creation_source_manifest"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "outputEvidence": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.phase_output_evidence"
        },
        "format_version": {
          "const": 2
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "enum": [
            "p00_brief",
            "p01_genre_style",
            "p02_world_laws",
            "p03_geography",
            "p04_timeline",
            "p05_societies",
            "p06_characters",
            "p07_systems",
            "p08_world_arcs",
            "p09_narrative_content",
            "p10_canon_lock",
            "p11_art_audio",
            "p12_asset_specs",
            "p13_asset_production",
            "p14_handoff"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "role": {
          "enum": [
            "asset_plan",
            "chronology",
            "content_lock",
            "experience_classification",
            "group_structures",
            "implementation_handoff",
            "interaction_ontology",
            "narrative_architecture",
            "player_actors",
            "presentation_direction",
            "project_brief",
            "runtime_compatibility",
            "systems_design",
            "typed_content",
            "world_topology"
          ]
        },
        "subject": {
          "allOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "properties": {
                "format": {
                  "enum": [
                    "world-forge.activity_module",
                    "world-forge.asset_inventory",
                    "world-forge.asset_manifest",
                    "world-forge.asset_spec",
                    "world-forge.asset_style",
                    "world-forge.asset_target",
                    "world-forge.creation_handoff",
                    "world-forge.creation_profile",
                    "world-forge.creation_readiness",
                    "world-forge.creation_source_manifest",
                    "world-forge.gamepack",
                    "world-forge.logic_module",
                    "world-forge.narrative_module",
                    "world-forge.project",
                    "world-forge.runtime_support_report",
                    "world-forge.system_module",
                    "world-forge.world_module"
                  ]
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "phase",
        "role",
        "subject",
        "reviewer",
        "content_hash"
      ],
      "type": "object"
    },
    "profileIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
