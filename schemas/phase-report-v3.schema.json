          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "rationale": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/id"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "reportCommon": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "extensions": {
          "items": {
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        },
        "format": {
          "const": "world-forge.phase_report"
        },
        "format_version": {
          "const": 3
        },
        "invalidation_dependencies": {
          "items": {
            "$ref": "#/$defs/identity"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "output_evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/outputEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "p00_brief",
            "p01_genre_style",
            "p02_world_laws",
            "p03_geography",
            "p04_timeline",
            "p05_societies",
            "p06_characters",
            "p07_systems",
            "p08_world_arcs",
            "p09_narrative_content",
            "p10_canon_lock",
            "p11_art_audio",
            "p12_asset_specs",
            "p13_asset_production",
            "p14_handoff"
          ]
        },
        "profile": {
          "$ref": "#/$defs/profileIdentity"
        },
        "project": {
          "$ref": "#/$defs/projectIdentity"
        },
        "rationale": {
          "$ref": "#/$defs/rationale"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "source_manifest": {
          "$ref": "#/$defs/manifestIdentity"
        },
        "status": {
          "enum": [
            "ready",
            "not_applicable"
          ]
        }
      },
      "required": [
        "format",
        "format_version",
        "project",
        "profile",
        "source_manifest",
        "phase",
        "status",
        "rationale",
        "evidence",
        "output_evidence",
        "reviewer",
        "invalidation_dependencies",
        "extensions",
        "content_hash"
