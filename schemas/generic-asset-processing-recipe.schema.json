        "kind": {
          "const": "font"
        },
        "max_bytes": {
          "$ref": "#/$defs/maxBytes"
        },
        "max_glyphs": {
          "maximum": 1114112,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "container",
        "glyph_ranges",
        "max_glyphs",
        "max_bytes"
      ],
      "type": "object"
    },
