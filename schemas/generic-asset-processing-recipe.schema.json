      "additionalProperties": false,
      "properties": {
        "container": {
          "enum": [
            "ttf",
            "otf"
          ]
        },
        "glyph_ranges": {
          "items": {
            "maxLength": 15,
            "pattern": "^U\\+[0-9A-F]{4,6}-[0-9A-F]{4,6}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
