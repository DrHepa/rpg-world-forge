{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-world-forge.local/schemas/studio-external-grant.schema.json",
  "title": "Forge Studio external artifact grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "grant_id",
    "workspace_id",
    "operation",
    "role",
    "artifact_kind",
    "display_name",
    "state",
    "expected_content_hash",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "format": {
      "const": "rpg-world-forge.studio_external_grant"
    },
    "format_version": {
      "const": 1
    },
    "grant_id": {
      "$ref": "#/$defs/entityId"
    },
    "workspace_id": {
      "$ref": "#/$defs/workspaceId"
    },
    "operation": {
      "enum": [
        "game.materialize",
        "game.package",
        "game.package.extract"
      ]
    },
    "role": {
      "enum": [
        "source",
        "target"
      ]
    },
    "artifact_kind": {
      "enum": [
        "game_materialization_bundle",
        "standalone_game",
        "game_package"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "state": {
      "enum": [
        "ready",
        "reserved",
        "recovery_required",
        "consumed",
        "revoked"
      ]
    },
    "expected_content_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "oneOf": [
    {
      "required": [
        "operation",
        "role",
        "artifact_kind"
      ],
      "properties": {
        "operation": {
          "const": "game.materialize"
        },
        "role": {
          "const": "source"
        },
        "artifact_kind": {
          "const": "game_materialization_bundle"
        }
      }
    },
    {
      "required": [
        "operation",
        "role",
        "artifact_kind"
      ],
      "properties": {
        "operation": {
          "const": "game.materialize"
        },
        "role": {
          "const": "target"
        },
        "artifact_kind": {
          "const": "standalone_game"
        }
      }
    },
    {
      "required": [
        "operation",
        "role",
        "artifact_kind"
      ],
      "properties": {
        "operation": {
          "const": "game.package"
        },
        "role": {
          "const": "source"
        },
        "artifact_kind": {
          "const": "standalone_game"
        }
      }
    },
    {
      "required": [
        "operation",
        "role",
        "artifact_kind"
      ],
      "properties": {
        "operation": {
          "const": "game.package"
        },
        "role": {
          "const": "target"
        },
        "artifact_kind": {
          "const": "game_package"
        }
      }
    },
    {
      "required": [
        "operation",
        "role",
        "artifact_kind"
      ],
      "properties": {
        "operation": {
          "const": "game.package.extract"
        },
        "role": {
          "const": "source"
        },
        "artifact_kind": {
          "const": "game_package"
        }
      }
    },
    {
      "required": [
        "operation",
        "role",
        "artifact_kind"
      ],
      "properties": {
        "operation": {
          "const": "game.package.extract"
        },
        "role": {
          "const": "target"
        },
        "artifact_kind": {
          "const": "standalone_game"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "game.materialize"
          },
          "role": {
            "const": "source"
          }
        },
        "required": [
          "operation",
          "role"
        ]
      },
      "then": {
        "properties": {
          "artifact_kind": {
            "const": "game_materialization_bundle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "game.package.extract"
          },
          "role": {
            "const": "source"
          }
        },
        "required": [
          "operation",
          "role"
        ]
      },
      "then": {
        "properties": {
          "artifact_kind": {
            "const": "game_package"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "game.package"
          },
          "role": {
            "const": "target"
          }
        },
        "required": [
          "operation",
          "role"
        ]
      },
      "then": {
        "properties": {
          "artifact_kind": {
            "const": "game_package"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "role": {
              "const": "target"
            }
          },
          "required": [
            "role"
          ]
        },
        "then": {
          "properties": {
            "artifact_kind": {
              "const": "standalone_game"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "game.package"
          },
          "role": {
            "const": "source"
          }
        },
        "required": [
          "operation",
          "role"
        ]
      },
      "then": {
        "properties": {
          "artifact_kind": {
            "const": "standalone_game"
          }
        }
      }
    }
  ],
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
