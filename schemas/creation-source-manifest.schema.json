{
  "$id": "https://world-forge.local/schemas/creation-source-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "extensions": {
      "items": {
        "$ref": "#/$defs/extension"
      },
      "type": "array"
    },
    "format": {
      "const": "world-forge.creation_source_manifest"
    },
    "format_version": {
      "const": 1
    },
    "modules": {
      "$ref": "#/$defs/moduleCollections"
    },
    "profile": {
      "$ref": "#/$defs/profileReference"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    }
  },
  "required": [
    "format",
    "format_version",
    "project_id",
    "profile",
    "modules",
    "extensions",
    "content_hash"
  ],
  "title": "World Forge creation source manifest v1",
  "type": "object",
  "$defs": {
    "activityModuleReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.activity_module"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "path",
        "content_hash"
      ],
      "type": "object"
    },
    "extension": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "id": {
          "$ref": "#/$defs/extensionId"
        },
        "required": {
          "type": "boolean"
        },
        "version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "required",
        "content_hash"
      ],
      "type": "object"
    },
    "extensionId": {
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
      "type": "string"
    },
    "id": {
      "pattern": "^(?!(?:aux|con|nul|prn|com[1-9]|lpt[1-9])$)[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "moduleCollections": {
      "additionalProperties": false,
      "description": "Each typed module collection is independently valid when empty.",
      "properties": {
        "activity_modules": {
          "items": {
            "$ref": "#/$defs/activityModuleReference"
          },
          "type": "array"
        },
        "logic_modules": {
          "items": {
            "$ref": "#/$defs/logicModuleReference"
          },
          "type": "array"
        },
        "narrative_modules": {
          "items": {
            "$ref": "#/$defs/narrativeModuleReference"
          },
          "type": "array"
        },
        "system_modules": {
          "items": {
            "$ref": "#/$defs/systemModuleReference"
          },
          "type": "array"
        },
        "world_modules": {
          "items": {
            "$ref": "#/$defs/worldModuleReference"
          },
          "type": "array"
        }
      },
      "required": [
        "world_modules",
        "activity_modules",
        "narrative_modules",
        "system_modules",
        "logic_modules"
      ],
      "type": "object"
    },
    "narrativeModuleReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.narrative_module"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "path",
        "content_hash"
      ],
      "type": "object"
    },
    "logicModuleReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.logic_module"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "path",
        "content_hash"
      ],
      "type": "object"
    },
    "path": {
      "description": "Portable NFC-normalized relative POSIX path. Python validation additionally enforces UTF-8 byte length, path depth, reserved names, trailing-dot/space rules, and NFC/casefold collisions that JSON Schema cannot express exactly.",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^<>:\"\\\\|?*\\u0000-\\u001F/]+(?:/[^<>:\"\\\\|?*\\u0000-\\u001F/]+)*$",
      "type": "string"
    },
    "profileReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.creation_profile"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "path",
        "content_hash"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "systemModuleReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.system_module"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "path",
        "content_hash"
      ],
      "type": "object"
    },
    "worldModuleReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.world_module"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "path",
        "content_hash"
      ],
      "type": "object"
    }
  }
}
