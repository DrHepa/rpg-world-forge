{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-forge.local/schemas/studio-creation-job.schema.json",
  "title": "World Forge Studio creation job v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "job_id",
    "workspace_id",
    "operation",
    "state",
    "generation",
    "authority",
    "inputs",
    "progress",
    "result",
    "error",
    "created_at",
    "started_at",
    "finished_at",
    "updated_at",
    "record_hash"
  ],
  "properties": {
    "format": {
      "const": "world-forge.studio_creation_job"
    },
    "format_version": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ]
    },
    "job_id": {
      "$ref": "#/$defs/entityId"
    },
    "workspace_id": {
      "$ref": "#/$defs/workspaceId"
    },
    "operation": {
      "enum": [
        "artifact.admit",
        "asset.process",
        "asset.release.seal",
        "creation.compile",
        "runtime.compose",
        "runtime.bundle.build",
        "game.materialization.bundle.build",
        "game.materialize",
        "game.package",
        "game.package.extract"
      ]
    },
    "operation_params": {
      "oneOf": [
        {
          "$ref": "#/$defs/assetProcessOperationParams"
        },
        {
          "$ref": "#/$defs/assetSealOperationParams"
        },
        {
          "$ref": "#/$defs/runtimeComposeOperationParams"
        },
        {
          "$ref": "#/$defs/runtimeBundleOperationParams"
        },
        {
          "$ref": "#/$defs/materializationBundleOperationParams"
        },
        {
          "$ref": "#/$defs/gameMaterializeOperationParams"
        },
        {
          "$ref": "#/$defs/gamePackageOperationParams"
        },
        {
          "$ref": "#/$defs/gamePackageExtractOperationParams"
        }
      ]
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "canceled",
        "orphaned"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "inputs": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/inputReference"
      }
    },
    "progress": {
      "enum": [
        "queued",
        "reserved",
        "worker_started",
        "output_published",
        "registry_committing",
        "committed",
        "cleanup_pending",
        "failed",
        "canceled",
        "orphaned"
      ]
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/resultV1V2"
        },
        {
          "$ref": "#/$defs/resultV3"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/resultV5"
        },
        {
          "$ref": "#/$defs/resultV6"
        },
        {
          "$ref": "#/$defs/resultV7"
        },
        {
          "$ref": "#/$defs/resultV8"
        },
        {
          "$ref": "#/$defs/resultV9"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "started_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "record_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "oneOf": [
    {
      "properties": {
        "format_version": {
          "const": 1
        },
        "operation": {
          "enum": [
            "artifact.admit",
            "creation.compile"
          ]
        },
        "operation_params": false,
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV1V2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 2
        },
        "operation": {
          "const": "asset.process"
        },
        "operation_params": {
          "$ref": "#/$defs/assetProcessOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV1V2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 3
        },
        "operation": {
          "const": "asset.release.seal"
        },
        "operation_params": {
          "$ref": "#/$defs/assetSealOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV3"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 4
        },
        "operation": {
          "const": "runtime.compose"
        },
        "operation_params": {
          "$ref": "#/$defs/runtimeComposeOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV1V2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 5
        },
        "operation": {
          "const": "runtime.bundle.build"
        },
        "operation_params": {
          "$ref": "#/$defs/runtimeBundleOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV5"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 6
        },
        "operation": {
          "const": "game.materialization.bundle.build"
        },
        "operation_params": {
          "$ref": "#/$defs/materializationBundleOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV6"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 7
        },
        "operation": {
          "const": "game.materialize"
        },
        "operation_params": {
          "$ref": "#/$defs/gameMaterializeOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV7"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 8
        },
        "operation": {
          "const": "game.package"
        },
        "operation_params": {
          "$ref": "#/$defs/gamePackageOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV8"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    },
    {
      "properties": {
        "format_version": {
          "const": 9
        },
        "operation": {
          "const": "game.package.extract"
        },
        "operation_params": {
          "$ref": "#/$defs/gamePackageExtractOperationParams"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/resultV9"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format_version",
        "operation",
        "operation_params"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "queued"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "const": "queued"
          },
          "result": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "started_at": {
            "type": "null"
          },
          "finished_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "running"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "enum": [
              "reserved",
              "worker_started",
              "output_published",
              "registry_committing"
            ]
          },
          "result": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "started_at": {
            "$ref": "#/$defs/timestamp"
          },
          "finished_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "enum": [
              "committed",
              "cleanup_pending"
            ]
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/$defs/resultV1V2"
              },
              {
                "$ref": "#/$defs/resultV3"
              },
              {
                "$ref": "#/$defs/resultV5"
              },
              {
                "$ref": "#/$defs/resultV6"
              },
              {
                "$ref": "#/$defs/resultV7"
              },
              {
                "$ref": "#/$defs/resultV8"
              },
              {
                "$ref": "#/$defs/resultV9"
              }
            ]
          },
          "error": {
            "type": "null"
          },
          "started_at": {
            "$ref": "#/$defs/timestamp"
          },
          "finished_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "const": "failed"
          },
          "result": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          },
          "finished_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "orphaned"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "const": "orphaned"
          },
          "result": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          },
          "finished_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "canceled"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "const": "canceled"
          },
          "result": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "finished_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          },
          "progress": {
            "const": "cleanup_pending"
          }
        },
        "required": [
          "state",
          "progress"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/$defs/resultV1V2"
                  },
                  {
                    "$ref": "#/$defs/resultV3"
                  },
                  {
                    "$ref": "#/$defs/resultV5"
                  },
                  {
                    "$ref": "#/$defs/resultV6"
                  },
                  {
                    "$ref": "#/$defs/resultV7"
                  },
                  {
                    "$ref": "#/$defs/resultV8"
                  },
                  {
                    "$ref": "#/$defs/resultV9"
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "cleanup_pending": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          },
          "progress": {
            "const": "committed"
          }
        },
        "required": [
          "state",
          "progress"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/$defs/resultV1V2"
                  },
                  {
                    "$ref": "#/$defs/resultV3"
                  },
                  {
                    "$ref": "#/$defs/resultV5"
                  },
                  {
                    "$ref": "#/$defs/resultV6"
                  },
                  {
                    "$ref": "#/$defs/resultV7"
                  },
                  {
                    "$ref": "#/$defs/resultV8"
                  },
                  {
                    "$ref": "#/$defs/resultV9"
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "cleanup_pending": {
                    "const": false
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "publicToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "properties": {
        "format": {
          "$ref": "#/$defs/operationId"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/entityId"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_generation",
        "source_revision",
        "workflow_status_hash",
        "artifact_snapshot_hash"
      ],
      "properties": {
        "root_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_revision": {
          "$ref": "#/$defs/sha256"
        },
        "workflow_status_hash": {
          "$ref": "#/$defs/nullableSha256"
        },
        "artifact_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "subject"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/entityId"
        },
        "subject": {
          "$ref": "#/$defs/artifactIdentity"
        }
      }
    },
    "acceptanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_index",
        "criterion_sha256",
        "status",
        "evidence_hashes"
      ],
      "properties": {
        "criterion_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "criterion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "failed",
            "passed"
          ]
        },
        "evidence_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "assetProcessOperationParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_artifact_ids",
        "recipe_id",
        "processing_receipt_id",
        "qa_report_id",
        "acceptance_results"
      ],
      "properties": {
        "license_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityId"
          }
        },
        "recipe_id": {
          "$ref": "#/$defs/entityId"
        },
        "processing_receipt_id": {
          "$ref": "#/$defs/entityId"
        },
        "qa_report_id": {
          "$ref": "#/$defs/entityId"
        },
        "acceptance_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/acceptanceResult"
          }
        }
      }
    },
    "retainedEvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "identity",
        "retention"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
        },
        "identity": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "retention": {
          "const": "active"
        }
      }
    },
    "recoveryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stage": {
          "$ref": "#/$defs/retainedEvidenceItem"
        },
        "journal": {
          "$ref": "#/$defs/retainedEvidenceItem"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "authority_changed",
            "canceled",
            "input_changed",
            "internal_error",
            "invalid_artifact",
            "invalid_project",
            "recovery_ambiguous",
            "recovery_required",
            "service_restart",
            "timeout",
            "worker_crashed",
            "worker_protocol"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "recovery_evidence": {
          "$ref": "#/$defs/recoveryEvidence"
        }
      }
    },
    "resultV1V2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_artifact_ids",
        "artifact_snapshot_hash",
        "analysis_status",
        "reason_codes",
        "cleanup_pending"
      ],
      "properties": {
        "output_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityId"
          }
        },
        "artifact_snapshot_hash": {
          "$ref": "#/$defs/sha256"
        },
        "analysis_status": {
          "enum": [
            "passed",
            "failed",
            "inconclusive",
            "unsupported",
            "not_applicable"
          ]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicToken"
          }
        },
        "cleanup_pending": {
          "type": "boolean"
        }
      }
    },
    "assetSealOperationParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qa_report_artifact_ids",
        "manifest_id",
        "target_grant_id",
        "target_grant_generation"
      ],
      "properties": {
        "qa_report_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityId"
          }
        },
        "manifest_id": {
          "$ref": "#/$defs/entityId"
        },
        "target_grant_id": {
          "$ref": "#/$defs/entityId"
        },
        "target_grant_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "assetpackIdentity": {
      "type": "object",
