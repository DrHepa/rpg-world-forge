  "$id": "https://world-forge.local/schemas/generic-runtime-support-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "$ref": "#/$defs/adapterIdentity"
    },
    "compatibility_status": {
      "enum": [
        "supported",
        "partially_supported",
        "unsupported"
      ]
    },
    "composition": {
      "$ref": "#/$defs/compositionIdentity"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "dimensions": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "absent",
            "declared",
            "verified"
          ]
        },
        "assets": {
          "enum": [
            "unplanned",
            "planned",
            "produced",
            "processed",
            "sealed",
            "failed"
          ]
        },
        "authoring": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "compilation": {
          "enum": [
            "not_requested",
            "compiled",
            "unsupported",
            "failed"
          ]
        },
        "execution": {
          "items": {
            "$ref": "#/$defs/execution"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "packaging": {
          "enum": [
            "unverified",
            "verified",
            "failed"
          ]
        },
        "release": {
          "enum": [
            "blocked",
            "ready"
          ]
        }
      },
      "required": [
        "authoring",
        "compilation",
        "assets",
        "adapter",
        "execution",
        "packaging",
        "release"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/evidenceReference"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "features": {
      "items": {
        "$ref": "#/$defs/feature"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "format": {
      "const": "world-forge.runtime_support_report"
    },
    "format_version": {
      "const": 1
    },
    "gamepack": {
      "$ref": "#/$defs/gamepackIdentity"
    },
    "mechanics": {
      "items": {
        "$ref": "#/$defs/mechanic"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "missing_capabilities": {
      "items": {
        "$ref": "#/$defs/token"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "report_id": {
      "$ref": "#/$defs/id"
    },
    "supported": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "format_version",
    "report_id",
    "gamepack",
    "composition",
    "adapter",
    "evidence",
    "dimensions",
    "compatibility_status",
    "mechanics",
    "features",
    "missing_capabilities",
    "reason_codes",
    "supported",
