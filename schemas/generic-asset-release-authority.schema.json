        "glyph_ranges": {
          "items": {
            "maxLength": 15,
            "pattern": "^U\\+[0-9A-F]{4,6}-[0-9A-F]{4,6}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-world-forge-canonical-glyph-ranges": true
        },
        "kind": {
          "const": "font"
        },
        "max_bytes": {
          "$ref": "#/$defs/maxBytes"
        },
        "max_glyphs": {
          "maximum": 1114112,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "container",
        "glyph_ranges",
        "max_glyphs",
        "max_bytes"
