{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-forge.local/schemas/studio-creation-workspace.schema.json",
  "title": "World Forge Studio creation workspace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "workspace_id",
    "project",
    "project_kind",
    "source_revision",
    "workflow_status_hash",
    "root_generation",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "format": { "const": "world-forge.studio_creation_workspace" },
    "format_version": { "const": 1 },
    "workspace_id": { "$ref": "#/$defs/workspaceId" },
    "project": { "$ref": "#/$defs/projectIdentity" },
    "project_kind": { "enum": ["game", "universe_library", "asset_library"] },
    "source_revision": { "$ref": "#/$defs/sha256" },
    "workflow_status_hash": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "root_generation": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "id", "content_hash"],
      "properties": {
        "format": { "const": "world-forge.project" },
        "format_version": { "const": 1 },
        "id": { "$ref": "#/$defs/entityId" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
