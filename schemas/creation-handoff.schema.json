{
  "$defs": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          },
          "if": {
            "properties": {
              "format": {
                "const": "world-forge.game_runtime_bundle"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^game_runtime_bundle_[0-9a-f]{48}$",
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "manifestIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.creation_source_manifest"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "profileIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.creation_profile"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "projectIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.project"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/creation-handoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/identity"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "format": {
      "const": "world-forge.creation_handoff"
    },
    "format_version": {
      "const": 1
    },
    "handoff_id": {
      "$ref": "#/$defs/id"
    },
    "handoff_status": {
      "enum": [
        "authoring_ready",
        "implementation_ready"
      ]
    },
    "profile": {
      "$ref": "#/$defs/profileIdentity"
    },
    "project": {
      "$ref": "#/$defs/projectIdentity"
    },
    "readiness": {
      "allOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "properties": {
            "format": {
              "const": "world-forge.creation_readiness"
            }
          },
          "type": "object"
        }
      ]
    },
    "release_blockers": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "source_manifest": {
      "$ref": "#/$defs/manifestIdentity"
    },
    "workflow_status": {
      "allOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "properties": {
            "format": {
              "const": "world-forge.creation_workflow_status"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "format",
    "format_version",
    "handoff_id",
    "project",
    "profile",
    "source_manifest",
    "workflow_status",
    "readiness",
    "artifacts",
    "handoff_status",
    "release_blockers",
    "content_hash"
  ],
  "title": "World Forge creation handoff v1",
  "type": "object"
}
