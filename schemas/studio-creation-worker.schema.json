        "analysis_status": {
          "enum": [
            "passed",
            "failed",
            "inconclusive",
            "unsupported",
            "not_applicable"
          ]
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicToken"
          }
        }
      }
    },
