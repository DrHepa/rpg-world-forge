{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-forge.local/schemas/studio-creation-evidence.schema.json",
  "title": "World Forge Studio creation evidence projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "evidence_id",
    "authority",
    "artifact_snapshot_hash",
    "artifact_counts",
    "dimensions",
    "blocker_reason_codes",
    "mechanics",
    "runtime",
    "assets",
    "materialization",
    "readiness",
    "handoff",
    "content_hash"
  ],
  "properties": {
    "format": { "const": "world-forge.studio_creation_evidence" },
    "format_version": { "const": 1 },
    "evidence_id": { "$ref": "#/$defs/entityId" },
    "authority": { "$ref": "#/$defs/authority" },
    "artifact_snapshot_hash": { "$ref": "#/$defs/sha256" },
    "artifact_counts": { "$ref": "#/$defs/artifactCounts" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "blocker_reason_codes": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operationId" }
    },
    "mechanics": { "$ref": "#/$defs/mechanics" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "assets": { "$ref": "#/$defs/assets" },
    "materialization": { "$ref": "#/$defs/materialization" },
    "readiness": {
      "$ref": "#/$defs/readinessIdentity"
    },
    "handoff": {
      "$ref": "#/$defs/handoffIdentity"
    },
    "content_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "publicToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "root_generation",
        "source_revision",
        "workflow_status_hash"
      ],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/workspaceId" },
        "root_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_revision": { "$ref": "#/$defs/sha256" },
        "workflow_status_hash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "artifactCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "invalidated", "historical", "candidate", "ignored"],
      "properties": {
        "active": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "invalidated": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "historical": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "candidate": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "ignored": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "executionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "status", "evidence_ids"],
      "properties": {
        "platform": { "$ref": "#/$defs/publicToken" },
        "status": {
          "enum": ["untested", "headless_verified", "native_verified", "failed"]
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityId" }
        }
      }
    },
    "executionRows": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/executionRow" }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoring",
        "compilation",
        "assets",
        "adapter",
        "execution",
        "packaging",
        "release"
      ],
      "properties": {
        "authoring": { "enum": ["valid", "invalid"] },
        "compilation": {
          "enum": ["not_requested", "compiled", "unsupported", "failed"]
        },
        "assets": {
          "enum": ["unplanned", "planned", "produced", "processed", "sealed", "failed"]
        },
        "adapter": { "enum": ["absent", "declared", "verified"] },
        "execution": { "$ref": "#/$defs/executionRows" },
        "packaging": { "enum": ["unverified", "verified", "failed"] },
        "release": { "enum": ["blocked", "ready"] }
      }
    },
    "featureIds": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/publicToken" }
    },
    "mechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "total",
        "status_counts",
        "required_features",
        "missing_features"
      ],
      "properties": {
        "artifact_id": {
          "oneOf": [{ "$ref": "#/$defs/entityId" }, { "type": "null" }]
        },
        "total": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported_current",
            "game_extension_verified",
            "authoring_only",
            "blocked"
          ],
          "properties": {
            "supported_current": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "game_extension_verified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "authoring_only": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "blocked": { "type": "integer", "minimum": 0, "maximum": 4096 }
          }
        },
        "required_features": { "$ref": "#/$defs/featureIds" },
        "missing_features": { "$ref": "#/$defs/featureIds" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_adapter",
        "resolved_adapter",
        "required_features",
        "missing_features",
        "platforms"
      ],
      "properties": {
        "requested_adapter": {
          "oneOf": [{ "$ref": "#/$defs/entityId" }, { "type": "null" }]
        },
        "resolved_adapter": {
          "oneOf": [{ "$ref": "#/$defs/entityId" }, { "type": "null" }]
        },
        "required_features": { "$ref": "#/$defs/featureIds" },
        "missing_features": { "$ref": "#/$defs/featureIds" },
        "platforms": { "$ref": "#/$defs/executionRows" }
      }
    },
    "nullableArtifactId": {
      "oneOf": [{ "$ref": "#/$defs/entityId" }, { "type": "null" }]
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_artifact_id",
        "target_artifact_id",
        "style_artifact_id",
        "inventory_artifact_id",
        "assetpack_artifact_id",
        "inventory_assets",
        "lineage_complete",
        "lineage_partial",
        "qa_passed",
        "qa_failed",
        "licensed"
      ],
      "properties": {
        "subject_artifact_id": { "$ref": "#/$defs/nullableArtifactId" },
        "target_artifact_id": { "$ref": "#/$defs/nullableArtifactId" },
        "style_artifact_id": { "$ref": "#/$defs/nullableArtifactId" },
        "inventory_artifact_id": { "$ref": "#/$defs/nullableArtifactId" },
        "assetpack_artifact_id": { "$ref": "#/$defs/nullableArtifactId" },
        "inventory_assets": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "lineage_complete": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "lineage_partial": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "qa_passed": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "qa_failed": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "licensed": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "state", "prerequisites"],
      "properties": {
        "enabled": { "const": false },
        "state": { "const": "blocked" },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "satisfied", "message"],
            "properties": {
              "code": { "$ref": "#/$defs/operationId" },
              "satisfied": { "type": "boolean" },
              "message": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    },
    "readinessIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "id", "content_hash"],
      "properties": {
        "format": { "const": "world-forge.creation_readiness" },
        "format_version": { "const": 1 },
        "id": { "$ref": "#/$defs/entityId" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "handoffIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "id", "content_hash"],
      "properties": {
        "format": { "const": "world-forge.creation_handoff" },
        "format_version": { "const": 1 },
        "id": { "$ref": "#/$defs/entityId" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
