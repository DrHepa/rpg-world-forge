{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-forge.local/schemas/world-project-migration-journal.schema.json",
  "title": "World Forge world-project migration journal record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "operation_id",
    "state",
    "from_format_version",
    "to_format_version",
    "source_sha256",
    "target_sha256",
    "backup_identity",
    "target_identity",
    "evidence_identity",
    "evidence_sha256"
  ],
  "properties": {
    "format": {"const": "world-forge.world_project_migration_journal"},
    "format_version": {"const": 1},
    "operation_id": {"$ref": "#/$defs/sha256"},
    "state": {"enum": ["prepared", "replaced", "verified", "cleanup_authorized"]},
    "from_format_version": {"const": 2},
    "to_format_version": {"const": 3},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "backup_identity": {"$ref": "#/$defs/identity"},
    "target_identity": {
      "oneOf": [
        {"$ref": "#/$defs/identity"},
        {"type": "null"}
      ]
    },
    "evidence_identity": {
      "oneOf": [
        {"$ref": "#/$defs/identity"},
        {"type": "null"}
      ]
    },
    "evidence_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "state": {"const": "prepared"},
        "target_identity": {"type": "null"},
        "evidence_identity": {"type": "null"},
        "evidence_sha256": {"type": "null"}
      }
    },
    {
      "properties": {
        "state": {"const": "replaced"},
        "target_identity": {"$ref": "#/$defs/identity"},
        "evidence_identity": {"type": "null"},
        "evidence_sha256": {"type": "null"}
      }
    },
    {
      "properties": {
        "state": {"const": "verified"},
        "target_identity": {"$ref": "#/$defs/identity"},
        "evidence_identity": {"$ref": "#/$defs/identity"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    {
      "properties": {
        "state": {"const": "cleanup_authorized"},
        "target_identity": {"$ref": "#/$defs/identity"},
        "evidence_identity": {"$ref": "#/$defs/identity"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  ],
  "$defs": {
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "inode"],
          "properties": {
            "device": {"type": "integer", "minimum": 0},
            "inode": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["volume_serial", "file_id"],
          "properties": {
            "volume_serial": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "file_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
          }
        }
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
