{
  "$defs": {
    "classification": {
      "additionalProperties": false,
      "properties": {
        "ending_ids": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "ending_kind": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "failure_ids": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "goal_ids": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "recovery_action_ids": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "required": [
        "goal_ids",
        "ending_ids",
        "ending_kind",
        "failure_ids",
        "recovery_action_ids",
        "terminal"
      ],
      "type": "object"
    },
    "host": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "const": "architecture:x86_64"
        },
        "backend": {
          "const": "backend:raylib"
        },
        "platform_family": {
          "enum": [
            "platform:linux",
            "platform:windows"
          ]
        },
        "platform_id": {
          "enum": [
            "platform:linux_x86_64",
            "platform:windows_x86_64"
          ]
        },
        "renderer": {
          "const": "raylib"
        }
      },
      "required": [
        "platform_id",
        "platform_family",
        "architecture",
        "backend",
        "renderer"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 2,
          "type": "string"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "parameters": {
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          {
            "maxLength": 4096,
            "type": "string"
          },
          {
            "items": {
              "maxLength": 4096,
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 0,
            "type": "array"
          }
        ]
      },
      "maxProperties": 256,
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "token": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/headless-evidence-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_set_id": {
      "pattern": "^headless_evidence_set_[0-9a-f]{40}$",
      "type": "string"
    },
    "execution_script": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_execution_script"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 2,
          "type": "string"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "file_count": {
      "maximum": 70,
      "minimum": 7,
      "type": "integer"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.@ /-]*$",
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "maximum": 4194304,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "maxItems": 70,
      "minItems": 7,
      "type": "array",
      "uniqueItems": true
    },
    "format": {
      "const": "world-forge.headless_evidence_set"
    },
    "format_version": {
      "const": 1
    },
    "headless_receipt": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.headless_execution_receipt"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 2,
          "type": "string"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "runtime_bundle": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_runtime_bundle"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 2,
          "type": "string"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "runtime_evidence": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "execution_status": {
          "const": "headless_verified"
        },
        "format": {
          "const": "world-forge.runtime_evidence"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 2,
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/host"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash",
        "execution_status",
        "platform"
      ],
      "type": "object"
    },
    "state": {
      "const": "committed"
    },
    "support": {
      "additionalProperties": false,
      "properties": {
        "compatibility_status": {
          "const": "partially_supported"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_support_report"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "maxLength": 128,
          "minLength": 2,
          "type": "string"
        },
        "release": {
          "const": "blocked"
        },
        "supported": {
          "const": false
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash",
        "compatibility_status",
        "release",
        "supported"
      ],
      "type": "object"
    },
    "total_bytes": {
      "maximum": 67108864,
      "minimum": 1,
      "type": "integer"
    },
    "tree_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "format",
    "format_version",
    "evidence_set_id",
    "state",
    "runtime_bundle",
    "execution_script",
    "headless_receipt",
    "runtime_evidence",
    "support",
    "files",
    "tree_hash",
    "file_count",
    "total_bytes",
    "content_hash"
  ],
  "title": "World Forge immutable external headless evidence set v1",
  "type": "object",
  "x-world-forge-canonical-content-hash": true,
  "x-world-forge-generic-headless-coherent": "headless_evidence_set"
}
