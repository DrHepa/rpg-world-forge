{
  "$defs": {
    "adapterIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_adapter"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "assetReleaseIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.asset_release_authority"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "assetpackIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.assetpack"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        },
        "inventory_hash": {
          "$ref": "#/$defs/sha256"
        },
        "root_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash",
        "root_hash",
        "inventory_hash"
      ],
      "type": "object"
    },
    "authorityId": {
      "maxLength": 128,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_]{1,127}$",
      "type": "string"
    },
    "compositionIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_runtime_composition"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "evidenceSetIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.headless_evidence_set"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "executionScriptIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_execution_script"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "extractionIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_package_extraction"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "gamepackIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.gamepack"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "headlessEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_set": {
          "$ref": "#/$defs/evidenceSetIdentity"
        },
        "execution_script": {
          "$ref": "#/$defs/executionScriptIdentity"
        },
        "headless_receipt": {
          "$ref": "#/$defs/headlessReceiptIdentity"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "runtime_bundle": {
          "$ref": "#/$defs/runtimeBundleIdentity"
        },
        "runtime_evidence": {
          "$ref": "#/$defs/runtimeEvidenceReference"
        }
      },
      "required": [
        "platform",
        "evidence_set",
        "runtime_bundle",
        "execution_script",
        "headless_receipt",
        "runtime_evidence"
      ],
      "type": "object"
    },
    "headlessReceiptIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.headless_execution_receipt"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^(?!(?:aux|con|nul|prn|com[1-9]|lpt[1-9])$)[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "inventoryIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.asset_inventory"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "packageEvidence": {
      "additionalProperties": false,
      "properties": {
        "extraction": {
          "$ref": "#/$defs/extractionIdentity"
        },
        "package": {
          "additionalProperties": false,
          "properties": {
            "archive_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "content_hash": {
              "$ref": "#/$defs/sha256"
            },
            "format": {
              "const": "world-forge.game_package"
            },
            "format_version": {
              "const": 1
            },
            "id": {
              "$ref": "#/$defs/authorityId"
            },
            "size_bytes": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "format",
            "format_version",
            "id",
            "content_hash",
            "archive_sha256",
            "size_bytes"
          ],
          "type": "object"
        },
        "payload_lock": {
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "$ref": "#/$defs/sha256"
            },
            "format": {
              "const": "world-forge.standalone_game_lock"
            },
            "format_version": {
              "const": 1
            },
            "id": {
              "$ref": "#/$defs/authorityId"
            },
            "tree_hash": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "format",
            "format_version",
            "id",
            "content_hash",
            "tree_hash"
          ],
          "type": "object"
        },
        "runtime_bundle_hash": {
          "$ref": "#/$defs/sha256"
        },
        "standalone_game": {
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "$ref": "#/$defs/sha256"
            },
            "format": {
              "const": "world-forge.standalone_game"
            },
            "format_version": {
              "const": 1
            },
            "game_id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "format",
            "format_version",
            "game_id",
            "content_hash"
          ],
          "type": "object"
        }
      },
      "required": [
        "package",
        "extraction",
        "standalone_game",
        "payload_lock",
        "runtime_bundle_hash"
      ],
      "type": "object"
    },
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?![./])(?!.*/(?:\\.{1,2})(?:/|$))(?!(?:.*[/])?(?:aux|con|nul|prn|com[1-9]|lpt[1-9])(?:[./]|$))[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*(?:/[a-zA-Z0-9_][a-zA-Z0-9_.@ -]*)*$",
      "type": "string"
    },
    "platform": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:linux"
            },
            "platform_id": {
              "const": "platform:linux_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "const": "architecture:x86_64"
            },
            "backend": {
              "const": "backend:raylib"
            },
            "platform_family": {
              "const": "platform:windows"
            },
            "platform_id": {
              "const": "platform:windows_x86_64"
            },
            "renderer": {
              "const": "raylib"
            }
          },
          "required": [
            "platform_id",
            "platform_family",
            "architecture",
            "backend",
            "renderer"
          ],
          "type": "object"
        }
      ]
    },
    "registryIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_adapter_registry"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "runtimeApi": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "runtimeBundleIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_runtime_bundle"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "runtimeEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "execution_status": {
          "const": "headless_verified"
        },
        "format": {
          "const": "world-forge.runtime_evidence"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        },
        "packaging_status": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "platform": {
          "$ref": "#/$defs/platform"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash",
        "platform",
        "execution_status",
        "packaging_status"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshotIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.game_runtime_snapshot"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "supportReference": {
      "additionalProperties": false,
      "properties": {
        "compatibility_status": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported"
          ]
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.runtime_support_report"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/authorityId"
        },
        "packaging_status": {
          "enum": [
            "unverified",
            "verified",
            "failed"
          ]
        },
        "release_status": {
          "const": "blocked"
        },
        "supported": {
          "const": false
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash",
        "compatibility_status",
        "packaging_status",
        "release_status",
        "supported"
      ],
      "type": "object"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "token": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$id": "https://world-forge.local/schemas/runtime-support-authority.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "$ref": "#/$defs/adapterIdentity"
    },
    "asset_inventory": {
      "$ref": "#/$defs/inventoryIdentity"
    },
    "asset_release_authority": {
      "$ref": "#/$defs/assetReleaseIdentity"
    },
    "assetpack": {
      "$ref": "#/$defs/assetpackIdentity"
    },
    "authority_id": {
      "$ref": "#/$defs/authorityId"
    },
    "composition": {
      "$ref": "#/$defs/compositionIdentity"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "format": {
      "const": "world-forge.runtime_support_authority"
    },
    "format_version": {
      "const": 1
    },
    "gamepack": {
      "$ref": "#/$defs/gamepackIdentity"
    },
    "headless_evidence": {
      "items": {
        "$ref": "#/$defs/headlessEvidence"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "native_status": {
      "const": "unavailable"
    },
    "package_evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/packageEvidence"
        }
      ]
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "registry": {
      "$ref": "#/$defs/registryIdentity"
    },
    "release_status": {
      "const": "blocked"
    },
    "runtime_evidence": {
      "items": {
        "$ref": "#/$defs/runtimeEvidenceReference"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "runtime_snapshot": {
      "$ref": "#/$defs/snapshotIdentity"
    },
    "runtime_support_report": {
      "$ref": "#/$defs/supportReference"
    },
    "supported": {
      "const": false
    }
  },
  "required": [
    "format",
    "format_version",
    "authority_id",
    "gamepack",
    "asset_inventory",
    "composition",
    "assetpack",
    "asset_release_authority",
    "adapter",
    "registry",
    "runtime_snapshot",
    "headless_evidence",
    "package_evidence",
    "runtime_evidence",
    "runtime_support_report",
    "native_status",
    "release_status",
    "supported",
    "reason_codes",
    "content_hash"
  ],
  "title": "World Forge trusted runtime support authority v1",
  "type": "object",
  "x-world-forge-canonical-content-hash": true,
  "x-world-forge-generic-runtime-coherent": "runtime-support-authority"
}
