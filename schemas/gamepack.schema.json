{
  "$id": "https://world-forge.local/schemas/gamepack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "logic": {
              "properties": {
                "narrative_cursor": {
                  "type": "null"
                },
                "narrative_transitions": {
                  "maxItems": 0,
                  "type": "array"
                }
              },
              "required": [
                "narrative_cursor",
                "narrative_transitions"
              ],
              "type": "object"
            },
            "modules": {
              "properties": {
                "narrative": {
                  "maxItems": 0,
                  "type": "array"
                }
              },
              "required": [
                "narrative"
              ],
              "type": "object"
            }
          },
          "required": [
            "logic",
            "modules"
          ],
          "type": "object"
        },
        {
          "properties": {
            "logic": {
              "properties": {
                "narrative_cursor": {
                  "$ref": "#/$defs/internalCursor"
                }
              },
              "required": [
                "narrative_cursor"
              ],
              "type": "object"
            },
            "modules": {
              "properties": {
                "narrative": {
                  "items": {
                    "$ref": "#/$defs/narrativeProjection"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "narrative"
              ],
              "type": "object"
            }
          },
          "required": [
            "logic",
            "modules"
          ],
          "type": "object"
        },
        {
          "properties": {
            "logic": {
              "properties": {
                "narrative_cursor": {
                  "type": "null"
                },
                "narrative_transitions": {
                  "maxItems": 0,
                  "type": "array"
                }
              },
              "required": [
                "narrative_cursor",
                "narrative_transitions"
              ],
              "type": "object"
            },
            "modules": {
              "properties": {
                "narrative": {
                  "items": {
                    "$ref": "#/$defs/authoredNarrativeProjection"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "narrative"
              ],
              "type": "object"
            }
          },
          "required": [
            "logic",
            "modules"
          ],
          "type": "object"
        }
      ]
    }
  ],
  "properties": {
    "analysis_requirements": {
      "$ref": "#/$defs/analysisRequirements"
    },
    "asset_requirements": {
      "items": {
        "$ref": "#/$defs/assetRequirement"
      },
      "maxItems": 1024,
      "minItems": 0,
      "type": "array"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "format": {
      "const": "world-forge.gamepack"
    },
    "format_version": {
      "const": 1
    },
    "game": {
      "$ref": "#/$defs/game"
    },
    "localization": {
      "$ref": "#/$defs/localization"
    },
    "logic": {
      "$ref": "#/$defs/logic"
    },
    "mechanic_requirements": {
      "items": {
        "$ref": "#/$defs/mechanicRequirement"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "modules": {
      "$ref": "#/$defs/modules"
    },
    "presentation": {
      "$ref": "creation-profile.schema.json#/$defs/presentation"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/provenance"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array"
    },
    "registered_extensions": {
      "items": {
        "$ref": "creation-profile.schema.json#/$defs/extension"
      },
      "maxItems": 64,
      "type": "array"
    },
    "runtime_requirements": {
      "$ref": "#/$defs/runtimeRequirements"
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "required": [
    "format",
    "format_version",
    "game",
    "source",
    "modules",
    "logic",
    "presentation",
    "asset_requirements",
    "runtime_requirements",
    "analysis_requirements",
    "localization",
    "mechanic_requirements",
    "provenance",
    "registered_extensions",
    "content_hash"
  ],
  "title": "World Forge deterministic gamepack v1",
  "type": "object",
  "$defs": {
    "analysisLimits": {
      "additionalProperties": false,
      "properties": {
        "candidate_evaluations": {
          "const": 262144
        },
        "depth": {
          "const": 512
        },
        "parameter_combinations_per_action": {
          "const": 4096
        },
        "state_bytes": {
          "const": 65536
        },
        "states": {
          "const": 16384
        },
        "total_state_bytes": {
          "const": 67108864
        },
        "total_witness_steps": {
          "const": 4096
        },
        "witness_traces": {
          "const": 128
        }
      },
      "required": [
        "candidate_evaluations",
        "depth",
        "parameter_combinations_per_action",
        "state_bytes",
        "states",
        "total_state_bytes",
        "total_witness_steps",
        "witness_traces"
      ],
      "type": "object"
    },
    "analysisRequirements": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "abstract_puzzle"
              }
            },
            "required": [
              "profile"
            ]
          },
          "then": {
            "properties": {
              "analyzer_id": {
                "const": "worldforge.abstract_puzzle_exhaustive"
              },
              "reason_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile": {
                "const": "branching_narrative"
              }
            },
            "required": [
              "profile"
            ]
          },
          "then": {
            "properties": {
              "analyzer_id": {
                "const": "worldforge.branching_narrative_exhaustive"
              },
              "reason_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile": {
                "const": "unsupported"
              }
            },
            "required": [
              "profile"
            ]
          },
          "then": {
            "properties": {
              "analyzer_id": {
                "const": "worldforge.unsupported_profile"
              },
              "reason_code": {
                "const": "analysis_profile_unsupported"
              }
            }
          }
        }
      ],
      "properties": {
        "analyzer_id": {
          "enum": [
            "worldforge.abstract_puzzle_exhaustive",
            "worldforge.branching_narrative_exhaustive",
            "worldforge.unsupported_profile"
          ]
        },
        "analyzer_version": {
          "const": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "limits": {
          "$ref": "#/$defs/analysisLimits"
        },
        "profile": {
          "enum": [
            "abstract_puzzle",
            "branching_narrative",
            "unsupported"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "profile",
        "analyzer_id",
        "analyzer_version",
        "reason_code",
        "limits",
        "content_hash"
      ],
      "type": "object"
    },
    "activity": {
      "additionalProperties": false,
      "properties": {
        "compiler_owned": false,
        "activity_type": {
          "enum": [
            "level",
            "mission",
            "quest",
            "scenario",
            "match",
            "race",
            "puzzle",
            "encounter",
            "contract",
            "expedition",
            "run",
            "tutorial",
            "challenge"
          ]
        },
        "asset_binding_ids": {
          "$ref": "#/$defs/idArray"
        },
        "effect_ids": {
          "$ref": "#/$defs/idArray"
        },
        "end_condition_ids": {
          "$ref": "#/$defs/idArray"
        },
        "event_ids": {
          "$ref": "#/$defs/idArray"
        },
        "failure_condition_ids": {
          "$ref": "#/$defs/idArray"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "participant_ids": {
          "$ref": "#/$defs/idArray"
        },
        "presentation_hook_ids": {
          "$ref": "#/$defs/idArray"
        },
        "spatial_context_ids": {
          "$ref": "#/$defs/idArray"
        },
        "start_condition_ids": {
          "$ref": "#/$defs/idArray"
        },
        "success_condition_ids": {
          "$ref": "#/$defs/idArray"
        },
        "title": {
          "$ref": "#/$defs/runtimeString"
        }
      },
      "required": [
        "id",
        "activity_type",
        "title",
        "participant_ids",
        "spatial_context_ids",
        "start_condition_ids",
        "end_condition_ids",
        "success_condition_ids",
        "failure_condition_ids",
        "effect_ids",
        "event_ids",
        "presentation_hook_ids",
        "asset_binding_ids"
      ],
      "type": "object"
    },
    "activityProjection": {
      "additionalProperties": false,
      "properties": {
        "activities": {
          "items": {
            "$ref": "#/$defs/activity"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/identity"
        },
        "title": {
          "$ref": "#/$defs/runtimeString"
        }
      },
      "required": [
        "source",
        "title",
        "activities"
      ],
      "type": "object"
    },
    "assetRequirement": {
      "additionalProperties": false,
      "properties": {
        "accepted_formats": {
          "$ref": "#/$defs/nonEmptyTokenArray"
        },
        "binding_id": {
          "$ref": "#/$defs/id"
        },
        "referencing_subjects": {
          "items": {
            "$ref": "#/$defs/assetSubject"
          },
          "maxItems": 1024,
          "minItems": 1,
          "type": "array"
        },
        "required": {
          "const": true
        },
        "roles": {
          "$ref": "#/$defs/nonEmptyTokenArray"
        },
        "usage_contexts": {
          "$ref": "#/$defs/nonEmptyTokenArray"
        }
      },
      "required": [
        "binding_id",
        "required",
        "accepted_formats",
        "roles",
        "usage_contexts",
        "referencing_subjects"
      ],
      "type": "object"
    },
    "assetSubject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "activity",
            "system",
            "narrative_unit",
            "presentation_hook",
            "mechanic"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "executionSemantics": {
      "additionalProperties": false,
      "properties": {
        "active_failure_recovery": {
          "const": "intersection"
        },
        "condition_collections": {
          "const": "and"
        },
        "condition_snapshot": {
          "const": "pre_transition"
        },
        "effect_order": {
          "const": "rule_order_then_reference_order"
        },
        "effect_state_operands": {
          "const": "current_candidate_state"
        },
        "ending_match": {
          "const": "exactly_one"
        },
        "event_commit": {
          "const": "after_success_rule_reference_order"
        },
        "invalid_transition": {
          "const": "reject_without_mutation"
        },
        "narrative_transition": {
          "const": "source_effects_then_cursor_atomic"
        },
        "owned_action_rules": {
          "const": "all_required"
        },
        "semantics_version": {
          "const": 1
        },
        "terminal_precedence": {
          "const": "endings_before_failures"
        }
      },
      "required": [
        "semantics_version",
        "owned_action_rules",
        "condition_collections",
        "condition_snapshot",
        "effect_order",
        "effect_state_operands",
        "event_commit",
        "active_failure_recovery",
        "terminal_precedence",
        "ending_match",
        "narrative_transition",
        "invalid_transition"
      ],
      "type": "object"
    },
    "game": {
      "additionalProperties": false,
      "properties": {
        "default_locale": {
          "$ref": "#/$defs/locale"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/runtimeString"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "default_locale"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "idArray": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "enum": [
            "world-forge.project",
            "world-forge.creation_profile",
            "world-forge.creation_source_manifest",
            "world-forge.world_module",
            "world-forge.activity_module",
            "world-forge.narrative_module",
            "world-forge.system_module",
            "world-forge.logic_module",
            "world-forge.gamepack"
          ]
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "initialState": {
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/runtimeString"
          },
          {
            "items": {
              "$ref": "#/$defs/runtimeString"
            },
            "maxItems": 256,
            "type": "array",
            "uniqueItems": true
          }
        ]
      },
      "maxProperties": 129,
      "minProperties": 1,
      "propertyNames": {
        "anyOf": [
          {
            "$ref": "logic-module.schema.json#/$defs/id"
          },
          {
            "const": "wf_internal_narrative_cursor"
          }
        ]
      },
      "type": "object"
    },
    "locale": {
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "type": "string"
    },
    "internalCursor": {
      "additionalProperties": false,
      "properties": {
        "compiler_owned": {
          "const": true
        },
        "allowed_values": {
          "$ref": "#/$defs/nonEmptyIdArray"
        },
        "id": {
          "const": "wf_internal_narrative_cursor"
        },
        "initial": {
          "$ref": "#/$defs/id"
        },
        "mutability": {
          "const": "mutable"
        },
        "persistence": {
          "const": "saved"
        },
        "type": {
          "const": "string"
        }
      },
      "required": [
        "compiler_owned",
        "id",
        "type",
        "initial",
        "allowed_values",
        "mutability",
        "persistence"
      ],
      "type": "object"
    },
    "localization": {
      "additionalProperties": false,
      "properties": {
        "externalized_text": {
          "type": "boolean"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/localizationReference"
          },
          "maxItems": 4096,
          "minItems": 1,
          "type": "array"
        },
        "source_locale": {
          "$ref": "#/$defs/locale"
        },
        "supported_locales": {
          "items": {
            "$ref": "#/$defs/locale"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "source_locale",
        "supported_locales",
        "externalized_text",
        "references"
      ],
      "type": "object"
    },
    "localizationReference": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/id"
        },
        "key": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "source_text": {
          "$ref": "#/$defs/runtimeString"
        },
        "subject_id": {
          "$ref": "#/$defs/id"
        },
        "subject_kind": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "key",
        "subject_kind",
        "subject_id",
        "field",
        "source_text"
      ],
      "type": "object"
    },
    "logic": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "narrative_cursor": {
                "type": "null"
              }
            },
            "required": [
              "narrative_cursor"
            ]
          },
          "then": {
            "properties": {
              "initial_state": {
                "propertyNames": {
                  "$ref": "logic-module.schema.json#/$defs/id"
                },
                "type": "object"
              },
              "narrative_transitions": {
                "maxItems": 0,
                "type": "array"
              },
              "state_schema": {
                "items": {
                  "$ref": "logic-module.schema.json#/$defs/stateVariable"
                },
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "initial_state": {
                "properties": {
                  "wf_internal_narrative_cursor": {
                    "$ref": "#/$defs/id"
                  }
                },
                "required": [
                  "wf_internal_narrative_cursor"
                ],
                "type": "object"
              },
          "state_schema": {
            "contains": {
              "$ref": "#/$defs/internalCursor"
            },
            "maxContains": 1,
            "minContains": 1,
            "type": "array",
            "x-world-forge-final-compiler-owned": true
          }
            }
          }
        }
      ],
      "properties": {
        "actions": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/action"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/condition"
          },
          "maxItems": 512,
          "minItems": 1,
          "type": "array"
        },
        "core_verbs": {
          "items": {
            "$ref": "creation-profile.schema.json#/$defs/coreVerb"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/effect"
          },
          "maxItems": 512,
          "minItems": 1,
          "type": "array"
        },
        "endings": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/ending"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "execution_semantics": {
          "$ref": "#/$defs/executionSemantics"
        },
        "events": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/event"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "failures": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/failure"
          },
          "maxItems": 64,
          "type": "array"
        },
        "goals": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/goal"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "initial_state": {
          "$ref": "#/$defs/initialState"
        },
        "mechanics": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/mechanic"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "narrative_cursor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/internalCursor"
            }
          ]
        },
        "narrative_transitions": {
          "items": {
            "$ref": "#/$defs/narrativeTransition"
          },
          "maxItems": 128,
          "type": "array"
        },
        "presentation_hooks": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/presentationHook"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "logic-module.schema.json#/$defs/rule"
          },
          "maxItems": 512,
          "minItems": 1,
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/identity"
        },
        "state_schema": {
          "items": {
            "oneOf": [
              {
                "$ref": "logic-module.schema.json#/$defs/stateVariable"
              },
              {
                "$ref": "#/$defs/internalCursor"
              }
            ]
          },
          "maxItems": 129,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/runtimeString"
        }
      },
      "required": [
        "source",
        "title",
        "state_schema",
        "initial_state",
        "core_verbs",
        "actions",
        "conditions",
        "effects",
        "rules",
        "goals",
        "failures",
        "endings",
        "events",
        "presentation_hooks",
        "mechanics",
        "narrative_cursor",
        "narrative_transitions",
        "execution_semantics"
      ],
      "type": "object"
    },
    "mechanicRequirement": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "core_verb_id": {
          "$ref": "#/$defs/id"
        },
        "mechanic_id": {
          "$ref": "#/$defs/id"
        },
        "required_feature_ids": {
          "$ref": "#/$defs/nonEmptyTokenArray"
        }
      },
      "required": [
        "mechanic_id",
        "core_verb_id",
        "action_id",
        "required_feature_ids"
      ],
      "type": "object"
