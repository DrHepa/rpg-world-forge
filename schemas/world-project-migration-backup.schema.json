{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-forge.local/schemas/world-project-migration-backup.schema.json",
  "title": "World Forge world-project migration backup v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "operation_id",
    "project_bytes_base64",
    "source_identity",
    "source_sha256",
    "source_size_bytes",
    "source_change_time_ns"
  ],
  "properties": {
    "format": {"const": "world-forge.world_project_migration_backup"},
    "format_version": {"const": 1},
    "operation_id": {"$ref": "#/$defs/sha256"},
    "project_bytes_base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "source_identity": {"$ref": "#/$defs/identity"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "source_size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "source_change_time_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "inode"],
          "properties": {
            "device": {"type": "integer", "minimum": 0},
            "inode": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["volume_serial", "file_id"],
          "properties": {
            "volume_serial": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "file_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
          }
        }
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
