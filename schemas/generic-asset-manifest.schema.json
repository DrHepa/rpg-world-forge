          "minimum": 0,
          "type": "integer"
        },
        "max_bytes": {
          "$ref": "#/$defs/maxBytes"
        },
        "max_joints": {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        "max_materials": {
          "maximum": 16384,
          "minimum": 0,
          "type": "integer"
        },
        "max_meshes": {
          "maximum": 16384,
          "minimum": 0,
          "type": "integer"
        },
        "max_nodes": {
          "maximum": 65536,
          "minimum": 0,
          "type": "integer"
        },
        "max_primitives": {
          "maximum": 262144,
          "minimum": 0,
          "type": "integer"
        },
        "max_triangles": {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
