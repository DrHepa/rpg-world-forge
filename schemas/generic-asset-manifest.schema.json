{
  "$defs": {
    "asset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "asset_id",
        "content_hash"
      ],
      "type": "object"
    },
    "assetSubjectIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "const": "world-forge.asset_subject"
        },
        "format_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "format",
        "format_version",
        "id",
        "content_hash"
      ],
      "type": "object"
    },
    "fontExpectation": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "enum": [
            "ttf",
            "otf"
          ]
        },
        "glyph_ranges": {
          "items": {
            "maxLength": 15,
            "pattern": "^U\\+[0-9A-F]{4,6}-[0-9A-F]{4,6}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-world-forge-canonical-glyph-ranges": true
        },
        "kind": {
          "const": "font"
        },
        "max_bytes": {
          "$ref": "#/$defs/maxBytes"
        },
        "max_glyphs": {
          "maximum": 1114112,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "container",
        "glyph_ranges",
        "max_glyphs",
        "max_bytes"
      ],
      "type": "object"
    },
    "gamepackIdentity": {
      "additionalProperties": false,
      "properties": {
